<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="map_path" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="sample_vehicle"/>
  <arg name="sensor_model" default="sample_sensor_kit"/>
  <arg name="data_path" default="$(env HOME)/autoware_data"/>

  <include file="$(find-pkg-share obigo_launch)/launch/planning_simulator.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="is_launch_autoware" value="true"/>
    <arg name="launch_file" value="adsw_control.launch.xml"/>
    <arg name="launch_system" value="true"/>
    <arg name="launch_system_monitor" value="false"/>
    <arg name="launch_dummy_diag_publisher" value="true"/>
    <arg name="is_launch_simulator" value="true"/>
    <arg name="sim_launch_file" value="obigo_simulator_component.launch.xml"/>
    <arg name="launch_simulator_dummy_perception" value="false"/>
    <arg name="launch_simulator_dummy_vehicle" value="true"/>
    <arg name="initial_engage_state" value="true"/>
    <arg name="pointcloud_container_name" value="pointcloud_container_control"/>
    <arg name="glog_name" value="glog_component_control"/>
  </include>
</launch>
