<?xml version="1.0"?>
<launch>
  <arg name="launch_dummy_perception"/>
  <arg name="launch_dummy_vehicle"/>
  <arg name="localization_sim_mode"/>
  <arg name="launch_dummy_doors"/>
  <arg name="launch_scenario_simulator_v2_adapter"/>
  <arg name="scenario_simulation" default="false"/>
  <arg name="perception/enable_detection_failure"/>
  <arg name="perception/enable_object_recognition"/>
  <arg name="perception/use_base_link_z"/>
  <arg name="sensing/visible_range"/>
  <arg name="vehicle_model"/>
  <arg name="initial_engage_state"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="vehicle_info_param_file"/>
  <arg name="raw_vehicle_cmd_converter_param_path"/>
  <arg name="launch_localization_state_helper" default="true"/>
  <arg name="launch_empty_occupancy_grid_helper" default="true"/>
  <arg name="launch_probabilistic_occupancy_grid" default="false"/>
  <arg name="occupancy_grid_map_updater" default="binary_bayes_filter" description="options: binary_bayes_filter"/>

  <group if="$(var launch_dummy_perception)">
    <include file="$(find-pkg-share autoware_dummy_perception_publisher)/launch/dummy_perception_publisher.launch.xml">
      <arg name="real" value="$(var perception/enable_detection_failure)"/>
      <arg name="use_object_recognition" value="$(var perception/enable_object_recognition)"/>
      <arg name="use_base_link_z" value="$(var perception/use_base_link_z)"/>
      <arg name="visible_range" value="$(var sensing/visible_range)"/>
    </include>
  </group>

  <group if="$(var perception/enable_object_recognition)">
    <push-ros-namespace namespace="perception/object_recognition"/>

    <include file="$(find-pkg-share autoware_multi_object_tracker)/launch/multi_object_tracker.launch.xml">
      <arg name="selected_input_channels" value="['detected_objects']"/>
      <arg name="output" value="/perception/object_recognition/tracking/objects"/>
      <arg
        name="data_association_matrix_path"
        value="$(find-pkg-share obigo_launch)/config/perception/object_recognition/tracking/multi_object_tracker/data_association_matrix.param.yaml"
      />
      <arg
        name="input_channels_path"
        value="$(find-pkg-share obigo_launch)/config/perception/object_recognition/tracking/multi_object_tracker/input_channels.param.yaml"
      />
      <arg
        name="tracker_setting_path"
        value="$(find-pkg-share obigo_launch)/config/perception/object_recognition/tracking/multi_object_tracker/multi_object_tracker_node.param.yaml"
      />
    </include>

    <include file="$(find-pkg-share autoware_map_based_prediction)/launch/map_based_prediction.launch.xml">
      <arg name="input_topic" value="/perception/object_recognition/tracking/objects"/>
      <arg name="output_topic" value="/perception/object_recognition/objects"/>
      <arg
        name="param_path"
        value="$(find-pkg-share obigo_launch)/config/perception/object_recognition/prediction/map_based_prediction.param.yaml"
      />
    </include>
  </group>

  <group unless="$(var perception/enable_object_recognition)">
    <push-ros-namespace namespace="perception/object_recognition"/>
    <node pkg="autoware_dummy_perception_publisher" exec="empty_objects_publisher" name="empty_objects_publisher" output="screen">
      <remap from="~/output/objects" to="/perception/object_recognition/objects"/>
    </node>
  </group>

  <group if="$(var launch_probabilistic_occupancy_grid)">
    <push-ros-namespace namespace="occupancy_grid_map"/>
    <include file="$(find-pkg-share tier4_perception_launch)/launch/occupancy_grid_map/probabilistic_occupancy_grid_map.launch.xml">
      <arg name="input_obstacle_pointcloud" value="true"/>
      <arg name="input_obstacle_and_raw_pointcloud" value="false"/>
      <arg name="input/obstacle_pointcloud" value="/perception/obstacle_segmentation/pointcloud"/>
      <arg name="output" value="/perception/occupancy_grid_map/map"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
      <arg name="occupancy_grid_map_method" value="laserscan_based_occupancy_grid_map"/>
      <arg name="occupancy_grid_map_param_path" value="$(find-pkg-share obigo_launch)/config/perception/occupancy_grid_map/laserscan_based_occupancy_grid_map.param.yaml"/>
      <arg name="occupancy_grid_map_updater" value="$(var occupancy_grid_map_updater)"/>
      <arg name="occupancy_grid_map_updater_param_path" value="$(find-pkg-share obigo_launch)/config/perception/occupancy_grid_map/$(var occupancy_grid_map_updater)_updater.param.yaml"/>
    </include>
  </group>

  <group if="$(var launch_empty_occupancy_grid_helper)">
    <node pkg="obigo_launch" exec="planning_sim_empty_occupancy_grid.py" name="planning_sim_empty_occupancy_grid" output="screen"/>
  </group>

  <group if="$(var launch_localization_state_helper)">
    <node pkg="obigo_launch" exec="planning_sim_localization_state.py" name="planning_sim_localization_state" output="screen"/>
  </group>
</launch>
