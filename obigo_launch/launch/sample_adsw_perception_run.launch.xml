<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="map_path" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="sample_vehicle"/>
  <arg name="sensor_model" default="sample_sensor_kit"/>
  <arg name="rviz" default="true"/>
  <arg name="rviz_config_name" default="autoware.rviz"/>
  <arg name="data_path" default="$(env HOME)/autoware_data"/>

  <include file="$(find-pkg-share obigo_launch)/launch/planning_simulator.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="is_launch_autoware" value="true"/>
    <arg name="launch_file" value="adsw_perception.launch.xml"/>
    <arg name="is_launch_simulator" value="true"/>
    <arg name="sim_launch_file" value="perception_simulator_component.launch.xml"/>
    <arg name="launch_simulator_dummy_perception" value="true"/>
    <arg name="launch_simulator_dummy_vehicle" value="false"/>
    <arg name="perception/enable_object_recognition" value="true"/>
    <arg name="rviz" value="$(var rviz)"/>
    <arg name="rviz_config_name" value="$(var rviz_config_name)"/>
    <arg name="pointcloud_container_name" value="pointcloud_container_perception"/>
    <arg name="glog_name" value="glog_component_perception"/>
  </include>
</launch>
